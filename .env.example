# ===================================================
# Exemplo de Configuração de Ambiente (.env.example)
# ===================================================

# Chave de API da Groq (obtenha em https://console.groq.com/keys)
GROQ_API_KEY=sua_chave_groq_aqui

# Modelo LLM da Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Configurações do Servidor
HOST=0.0.0.0
PORT=5000
DEBUG=True
